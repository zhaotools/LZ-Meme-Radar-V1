{
  "name": "lz-meme-radar-v1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b --pretty false",
    "worker:dev": "wrangler dev",
    "worker:test": "vitest run tests/worker.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply lz-meme-radar --local",
    "db:migrate:remote": "wrangler d1 migrations apply lz-meme-radar --remote",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260906.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  },
  "packageManager": "pnpm@11.19.0"
}
